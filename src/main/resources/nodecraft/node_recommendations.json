{
  "version": 2,
  "defaults": {
    "limit": 8,
    "workflowOrder": [
      "output.preview",
      "geometry.architectural_primitives",
      "geometry.boolean",
      "geometry.combine",
      "transform.placement",
      "transform",
      "pattern",
      "material",
      "output.execute",
      "world.write"
    ],
    "excludeCategories": [
      "utilities.organization",
      "flow"
    ],
    "excludeNodeIds": [
      "utilities.organization.subgraph_register"
    ]
  },
  "sourceNodes": {
    "geometry.primitives.box": {
      "outputs": {
        "output_geometry": {
          "downstream": [
            {
              "nodeId": "transform.basic_transforms.transform_geometry",
              "order": 0,
              "reason": "变换几何体",
              "connectPortId": "input_geometry"
            },
            {
              "nodeId": "geometry.combine.geometry",
              "order": 10,
              "reason": "合并多个部件",
              "connectPortId": "input_geometry_0"
            },
            {
              "nodeId": "geometry.boolean.difference",
              "order": 11,
              "reason": "布尔差集",
              "connectPortId": "input_base"
            },
            {
              "nodeId": "output.preview.geometry_viewer",
              "order": 20,
              "reason": "即时预览",
              "connectPortId": "input_geometry"
            },
            {
              "nodeId": "material.basic_assignment.assign_block_type",
              "order": 30,
              "reason": "分配方块材质",
              "connectPortId": "input_geometry"
            },
            {
              "nodeId": "geometry.voxel.voxelize_geometry",
              "order": 40,
              "reason": "烘焙为方块",
              "connectPortId": "input_geometry"
            }
          ]
        },
        "output_box_blocks": {
          "downstream": [
            {
              "nodeId": "material.basic_assignment.assign_block_type",
              "order": 0,
              "connectPortId": "input_coordinates"
            },
            {
              "nodeId": "output.execute.apply_changes",
              "order": 10
            }
          ]
        }
      }
    },
