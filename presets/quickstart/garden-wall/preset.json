{
  "preset_id": "quickstart.garden_wall",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Garden Wall with Gate",
    "name_i18n": {
      "zh_CN": "带门的花园围墙",
      "en_US": "Garden Wall with Gate"
    },
    "description": "A simple wall segment with an arched gateway opening, perfect for gardens and courtyards.",
    "description_i18n": {
      "zh_CN": "带有拱形门道的简单墙段，非常适合花园和庭院。",
      "en_US": "A simple wall segment with an arched gateway opening, perfect for gardens and courtyards."
    },
    "author": "NodeCraft Team",
    "tags": [
      "wall",
      "gate",
      "garden",
      "quickstart",
      "beginner"
    ],
    "category": "quickstart",
    "difficulty": "beginner",
    "estimated_build_time": "2 minutes",
    "estimated_node_count": 12
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "wall_length",
      "name": "Wall Length",
      "type": "integer",
      "default": 12,
      "min": 6,
      "max": 32,
      "step": 1,
      "description": "Total length of the wall",
      "group": "Dimensions"
    },
    {
      "id": "wall_height",
      "name": "Wall Height",
      "type": "integer",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1,
      "description": "Height of the wall",
      "group": "Dimensions"
    },
    {
      "id": "wall_thickness",
      "name": "Wall Thickness",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1,
      "description": "Thickness of the wall",
      "group": "Dimensions"
    },
    {
      "id": "gate_width",
      "name": "Gate Width",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 6,
      "step": 1,
      "description": "Width of the gate opening",
      "group": "Gate"
    },
    {
      "id": "gate_height",
      "name": "Gate Height",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1,
      "description": "Height of the gate opening",
      "group": "Gate"
    },
    {
      "id": "wall_material",
      "name": "Wall Material",
      "type": "block_selector",
      "default": "minecraft:cobblestone",
      "description": "Block type for the wall",
      "group": "Materials"
    },
    {
      "id": "add_crenellations",
      "name": "Add Crenellations",
      "type": "boolean",
      "default": false,
      "description": "Add battlements to top of wall",
      "group": "Features"
    }
  ],
