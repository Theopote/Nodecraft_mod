{
  "preset_id": "quickstart.basic_box",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Basic Box",
    "name_i18n": {
      "zh_CN": "基础方块",
      "en_US": "Basic Box"
    },
    "description": "A simple box structure. Perfect for beginners to learn the basics of NodeCraft.",
    "description_i18n": {
      "zh_CN": "一个简单的方块结构。非常适合初学者学习 NodeCraft 的基础知识。",
      "en_US": "A simple box structure. Perfect for beginners to learn the basics of NodeCraft."
    },
    "author": "NodeCraft Team",
    "tags": [
      "beginner",
      "basic",
      "quickstart",
      "geometry"
    ],
    "category": "quickstart",
    "difficulty": "beginner",
    "estimated_build_time": "1 minute",
    "estimated_node_count": 6
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "width",
      "name": "Width",
      "type": "integer",
      "default": 8,
      "min": 1,
      "max": 32,
      "step": 1,
      "description": "Width of the box in blocks",
      "group": "Dimensions"
    },
    {
      "id": "height",
      "name": "Height",
      "type": "integer",
      "default": 8,
      "min": 1,
      "max": 32,
      "step": 1,
      "description": "Height of the box in blocks",
      "group": "Dimensions"
    },
    {
      "id": "depth",
      "name": "Depth",
      "type": "integer",
      "default": 8,
      "min": 1,
      "max": 32,
      "step": 1,
      "description": "Depth of the box in blocks",
      "group": "Dimensions"
    },
    {
      "id": "material",
      "name": "Material",
      "type": "block_selector",
      "default": "minecraft:stone",
      "description": "Block type to use for the box",
      "group": "Materials"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "node_player_pos",
        "type": "input.context.player_position",
        "position": {
          "x": 0.0,
          "y": 140.0
        },
        "parameters": {}
      },
      {
        "id": "node_box",
        "type": "geometry.primitives.box",
        "position": {
          "x": 280.0,
          "y": 140.0
        },
        "parameters": {
          "sizeX": {
            "value": 5.0
          },
          "sizeY": {
            "value": 5.0
          },
          "sizeZ": {
            "value": 5.0
          }
        }
      },
      {
        "id": "node_preview_geometry",
        "type": "output.preview.preview_geometry",
        "position": {
          "x": 580.0,
          "y": 40.0
        },
        "parameters": {}
      },
      {
        "id": "node_voxelize",
        "type": "geometry.voxel.voxelize_geometry",
        "position": {
          "x": 580.0,
          "y": 240.0
        },
        "parameters": {}
      },
      {
        "id": "node_material",
        "type": "material.basic_assignment.assign_block_type",
        "position": {
          "x": 860.0,
          "y": 240.0
        },
        "parameters": {}
      },
      {
        "id": "node_preview_blocks",
        "type": "output.preview.preview_blocks",
        "position": {
          "x": 1140.0,
          "y": 240.0
        },
        "parameters": {}
      }
    ],
    "connections": [
      {
        "from": {
          "node": "node_player_pos",
          "port": "output_position"
        },
        "to": {
          "node": "node_box",
          "port": "input_center"
        }
      },
      {
        "from": {
          "node": "node_box",
          "port": "output_geometry"
        },
        "to": {
          "node": "node_preview_geometry",
          "port": "input_geometry"
        }
      },
      {
        "from": {
          "node": "node_box",
          "port": "output_geometry"
        },
        "to": {
          "node": "node_voxelize",
          "port": "input_geometry"
        }
      },
      {
        "from": {
          "node": "node_voxelize",
          "port": "output_blocks"
        },
        "to": {
          "node": "node_material",
          "port": "input_coordinates"
        }
      },
      {
        "from": {
          "node": "node_material",
          "port": "output_placements"
        },
        "to": {
          "node": "node_preview_blocks",
          "port": "input_block_placements"
        }
      }
    ]
  },
  "documentation": {
    "learning_notes": "This preset demonstrates the basic workflow in NodeCraft: get player position, create geometry, voxelize, assign material, and preview (Apply Changes writes the world). Try adjusting the parameters to see how the box changes.",
    "tips": [
      "Start with small dimensions to quickly see results",
      "Try different materials to see how they look",
      "The player position determines where the box is placed"
    ],
    "related_presets": [
      "quickstart.basic_sphere",
      "quickstart.basic_cylinder"
    ]
  }
}
