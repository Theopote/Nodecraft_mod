{
  "preset_id": "quickstart.simple_tower",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Simple Tower",
    "name_i18n": {
      "zh_CN": "简单塔楼",
      "en_US": "Simple Tower"
    },
    "description": "A cylindrical tower with windows. Great for castles and fortifications.",
    "description_i18n": {
      "zh_CN": "一个带窗户的圆柱形塔楼。非常适合城堡和防御工事。",
      "en_US": "A cylindrical tower with windows. Great for castles and fortifications."
    },
    "author": "NodeCraft Team",
    "tags": [
      "tower",
      "castle",
      "medieval",
      "quickstart"
    ],
    "category": "quickstart",
    "difficulty": "beginner",
    "estimated_build_time": "2 minutes",
    "estimated_node_count": 12
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "height",
      "name": "Tower Height",
      "type": "integer",
      "default": 20,
      "min": 5,
      "max": 64,
      "step": 1,
      "description": "Height of the tower in blocks",
      "group": "Dimensions"
    },
    {
      "id": "radius",
      "name": "Tower Radius",
      "type": "integer",
      "default": 4,
      "min": 2,
      "max": 16,
      "step": 1,
      "description": "Radius of the tower in blocks",
      "group": "Dimensions"
    },
    {
      "id": "wall_thickness",
      "name": "Wall Thickness",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1,
      "description": "Thickness of the tower walls",
      "group": "Dimensions"
    },
    {
      "id": "material",
      "name": "Wall Material",
      "type": "block_selector",
      "default": "minecraft:stone_bricks",
      "description": "Block type for the tower walls",
      "group": "Materials"
    },
    {
      "id": "window_spacing",
      "name": "Window Spacing",
      "type": "integer",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1,
      "description": "Vertical spacing between windows",
      "group": "Windows"
    }
  ],
  "graph": {
    "nodes": [
