          "startX": {
            "value": 0.0
          },
          "startY": {
            "value": 0.0
          },
          "startZ": {
            "value": 0.0
          },
          "endX": {
            "value": 0.0
          },
          "endY": {
            "value": 12.0
          },
          "endZ": {
            "value": 0.0
          },
          "radius": {
            "value": 4.0
          }
        }
      },
      {
        "id": "node_inner",
        "type": "geometry.primitives.cylinder",
        "position": {
          "x": 0.0,
          "y": 580.0
        },
        "parameters": {
          "startX": {
            "value": 0.0
          },
          "startY": {
            "value": 0.0
          },
          "startZ": {
            "value": 0.0
          },
          "endX": {
            "value": 0.0
          },
          "endY": {
            "value": 12.0
          },
          "endZ": {
            "value": 0.0
          },
          "radius": {
            "value": 3.0
          }
        }
      },
      {
        "id": "node_hollow",
        "type": "geometry.boolean.difference",
        "position": {
          "x": 320.0,
          "y": 400.0
        },
        "parameters": {}
      },
      {
        "id": "node_move_to_pos",
        "type": "transform.basic_transforms.move_geometry",
        "position": {
          "x": 960.0,
          "y": 310.0
        },
        "parameters": {}
      },
      {
        "id": "node_preview_geometry",
        "type": "output.preview.preview_geometry",
        "position": {
          "x": 1280.0,
          "y": 220.0
        },
        "parameters": {}
      },
      {
        "id": "node_voxelize",
        "type": "geometry.voxel.voxelize_geometry",
