{
  "preset_id": "quickstart.basic_sphere",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Basic Sphere",
    "name_i18n": {
      "zh_CN": "基础球体",
      "en_US": "Basic Sphere"
    },
    "description": "A simple sphere structure. Great for domes, planets, or decorative elements.",
    "description_i18n": {
      "zh_CN": "简单的球体结构。非常适合圆顶、星球或装饰元素。",
      "en_US": "A simple sphere structure. Great for domes, planets, or decorative elements."
    },
    "author": "NodeCraft Team",
    "tags": [
      "sphere",
      "dome",
      "basic",
      "quickstart"
    ],
    "category": "quickstart",
    "difficulty": "beginner",
    "estimated_build_time": "1 minute",
    "estimated_node_count": 7
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "radius",
      "name": "Sphere Radius",
      "type": "integer",
      "default": 6,
      "min": 2,
      "max": 20,
      "step": 1,
      "description": "Radius of the sphere",
      "group": "Dimensions"
    },
    {
      "id": "material",
      "name": "Material",
      "type": "block_selector",
      "default": "minecraft:stone",
      "description": "Block type for the sphere",
      "group": "Materials"
    },
    {
      "id": "hollow",
      "name": "Hollow Sphere",
      "type": "boolean",
      "default": false,
      "description": "Create a hollow sphere (shell only)",
      "group": "Options"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "node_player_pos",
        "type": "input.context.player_position",
        "position": {
          "x": 0.0,
          "y": 140.0
        },
        "parameters": {}
      },
      {
        "id": "node_sphere",
        "type": "geometry.primitives.sphere",
        "position": {
          "x": 280.0,
          "y": 140.0
        },
        "parameters": {
          "radius": {
            "value": 5.0
          }
        }
      },
      {
        "id": "node_preview_geometry",
        "type": "output.preview.preview_geometry",
        "position": {
          "x": 580.0,
          "y": 40.0
        },
        "parameters": {}
      },
      {
        "id": "node_voxelize",
        "type": "geometry.voxel.voxelize_geometry",
        "position": {
          "x": 580.0,
          "y": 240.0
        },
        "parameters": {}
      },
      {
        "id": "node_material",
        "type": "material.basic_assignment.assign_block_type",
        "position": {
          "x": 860.0,
          "y": 240.0
        },
        "parameters": {}
      },
      {
        "id": "node_preview_blocks",
        "type": "output.preview.preview_blocks",
        "position": {
          "x": 1140.0,
          "y": 240.0
        },
        "parameters": {}
      },
      {
        "id": "node_material_block_type",
        "type": "input.type_selectors.block_type_selector",
        "position": {
          "x": 1180.0,
          "y": 320.0
        },
        "parameters": {
          "selectedBlock": {
            "value": "minecraft:stone"
          }
        }
      }
    ],
    "connections": [
      {
        "from": {
          "node": "node_player_pos",
          "port": "output_position"
        },
        "to": {
          "node": "node_sphere",
          "port": "input_center"
        }
      },
      {
        "from": {
          "node": "node_sphere",
          "port": "output_geometry"
        },
        "to": {
          "node": "node_preview_geometry",
          "port": "input_geometry"
        }
      },
      {
        "from": {
          "node": "node_sphere",
          "port": "output_geometry"
        },
        "to": {
          "node": "node_voxelize",
          "port": "input_geometry"
        }
      },
      {
        "from": {
          "node": "node_voxelize",
          "port": "output_blocks"
        },
        "to": {
          "node": "node_material",
          "port": "input_coordinates"
        }
      },
      {
        "from": {
          "node": "node_material",
          "port": "output_placements"
        },
        "to": {
          "node": "node_preview_blocks",
          "port": "input_block_placements"
        }
      },
      {
        "from": {
          "node": "node_material_block_type",
          "port": "output_block_id"
        },
        "to": {
          "node": "node_material",
          "port": "input_block_type"
        }
      }
    ]
  },
  "documentation": {
    "learning_notes": "This preset demonstrates basic sphere primitive usage. Spheres are perfect for organic shapes and domes.",
    "tips": [
      "Use for planet or moon decorations",
      "Half-sphere makes great dome roofs",
      "Hollow spheres create interesting structures",
      "Combine with boolean operations for complex shapes",
      "Use different materials for varied effects"
    ],
    "related_presets": [
      "quickstart.basic_box",
      "quickstart.simple_tower"
    ]
  }
}
