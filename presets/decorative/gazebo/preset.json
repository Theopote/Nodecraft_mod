{
  "preset_id": "decorative.gazebo",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Garden Gazebo",
    "name_i18n": {
      "zh_CN": "花园凉亭",
      "en_US": "Garden Gazebo"
    },
    "description": "An open-air pavilion perfect for gardens and parks.",
    "description_i18n": {
      "zh_CN": "适合花园和公园的露天凉亭。",
      "en_US": "An open-air pavilion perfect for gardens and parks."
    },
    "author": "NodeCraft Team",
    "tags": [
      "gazebo",
      "pavilion",
      "garden",
      "decorative"
    ],
    "category": "decorative",
    "difficulty": "intermediate",
    "estimated_build_time": "4 minutes",
    "estimated_node_count": 20
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "size",
      "name": "Gazebo Size",
      "type": "integer",
      "default": 6,
      "min": 4,
      "max": 12,
      "step": 1,
      "description": "Diameter of the gazebo",
      "group": "Dimensions"
    },
    {
      "id": "height",
      "name": "Wall Height",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1,
      "description": "Height of the gazebo walls",
      "group": "Dimensions"
    },
    {
      "id": "roof_height",
      "name": "Roof Height",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 6,
      "step": 1,
      "description": "Height of the roof cone",
      "group": "Dimensions"
    },
    {
      "id": "column_count",
      "name": "Column Count",
      "type": "integer",
      "default": 6,
      "min": 4,
      "max": 12,
      "step": 1,
      "description": "Number of support columns",
      "group": "Structure"
    },
    {
      "id": "floor_material",
      "name": "Floor Material",
      "type": "block_selector",
      "default": "minecraft:oak_planks",
      "description": "Block type for floor",
      "group": "Materials"
    },
    {
      "id": "column_material",
      "name": "Column Material",
      "type": "block_selector",
      "default": "minecraft:oak_log",
      "description": "Block type for columns",
      "group": "Materials"
    },
    {
      "id": "roof_material",
      "name": "Roof Material",
      "type": "block_selector",
      "default": "minecraft:oak_stairs",
      "description": "Block type for roof",
      "group": "Materials"
    }
