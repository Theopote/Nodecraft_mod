{
  "preset_id": "building_elements.roofs.gable_roof",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Gable Roof",
    "name_i18n": {
      "zh_CN": "山墙屋顶",
      "en_US": "Gable Roof"
    },
    "description": "A classic gable (pitched) roof with adjustable pitch and overhang.",
    "description_i18n": {
      "zh_CN": "经典的山墙（斜坡）屋顶，可调节坡度和悬挑。",
      "en_US": "A classic gable (pitched) roof with adjustable pitch and overhang."
    },
    "author": "NodeCraft Team",
    "tags": [
      "roof",
      "gable",
      "pitched",
      "building-element"
    ],
    "category": "building_elements",
    "difficulty": "beginner",
    "estimated_build_time": "2 minutes",
    "estimated_node_count": 13
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "width",
      "name": "Building Width",
      "type": "integer",
      "default": 10,
      "min": 4,
      "max": 32,
      "step": 1,
      "description": "Width of the building (X direction)",
      "group": "Dimensions"
    },
    {
      "id": "length",
      "name": "Building Length",
      "type": "integer",
      "default": 12,
      "min": 4,
      "max": 32,
      "step": 1,
      "description": "Length of the building (Z direction)",
      "group": "Dimensions"
    },
    {
      "id": "pitch",
      "name": "Roof Pitch",
      "type": "float",
      "default": 0.7,
      "min": 0.3,
      "max": 1.5,
      "step": 0.1,
      "description": "Steepness of the roof (height per horizontal unit)",
      "group": "Shape"
    },
    {
      "id": "overhang",
      "name": "Overhang",
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 3,
      "step": 1,
      "description": "How far the roof extends beyond walls",
      "group": "Shape"
    },
    {
      "id": "roof_material",
      "name": "Roof Material",
      "type": "block_selector",
      "default": "minecraft:oak_stairs",
      "description": "Block type for the roof",
      "group": "Materials"
    }
  ],
  "graph": {
