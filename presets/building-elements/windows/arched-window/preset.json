{
  "preset_id": "building_elements.windows.arched_window",
  "version": "1.0.0",
  "schema_version": "1.0",
  "metadata": {
    "name": "Arched Window",
    "name_i18n": {
      "zh_CN": "拱形窗户",
      "en_US": "Arched Window"
    },
    "description": "A medieval-style arched window with stone frame and glass panes.",
    "description_i18n": {
      "zh_CN": "带有石框和玻璃的中世纪风格拱形窗户。",
      "en_US": "A medieval-style arched window with stone frame and glass panes."
    },
    "author": "NodeCraft Team",
    "tags": [
      "window",
      "medieval",
      "arched",
      "building-element"
    ],
    "category": "building_elements",
    "difficulty": "beginner",
    "estimated_build_time": "2 minutes",
    "estimated_node_count": 16
  },
  "thumbnails": {
    "main": "",
    "previews": []
  },
  "parameters": [
    {
      "id": "width",
      "name": "Window Width",
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 6,
      "step": 1,
      "description": "Width of the window opening",
      "group": "Dimensions"
    },
    {
      "id": "height",
      "name": "Window Height",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 8,
      "step": 1,
      "description": "Height of the straight part",
      "group": "Dimensions"
    },
    {
      "id": "arch_height",
      "name": "Arch Height",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 3.0,
      "step": 0.5,
      "description": "Height of the arch at the top",
      "group": "Dimensions"
    },
    {
      "id": "depth",
      "name": "Frame Depth",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1,
      "description": "Depth of the window in blocks",
      "group": "Dimensions"
    },
    {
      "id": "frame_material",
      "name": "Frame Material",
      "type": "block_selector",
      "default": "minecraft:stone_bricks",
      "description": "Block type for window frame",
      "group": "Materials"
    },
    {
      "id": "glass_material",
      "name": "Glass Material",
      "type": "block_selector",
      "default": "minecraft:glass_pane",
      "description": "Block type for window glass",
      "group": "Materials"
    }
  ],
